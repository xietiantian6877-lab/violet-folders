{
  "name": "violet-folders",
  "version": "1.2.1",
  "private": true,
  "description": "Purple liquid glass folder shelf for Windows",
  "author": "Violet Folders contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build:native && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:native": "node scripts/build-native-capture.mjs",
    "build:runtime": "node node_modules/electron/install.js",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/electron/*.test.cjs",
    "dist": "npm run build:runtime && npm run build:native && npm run build && electron-builder --win --x64 --publish never && node scripts/checksums.mjs",
    "preview": "vite --host 127.0.0.1 --mode demo"
  },
  "build": {
    "appId": "dev.violet.folders",
    "productName": "Violet Folders",
    "asar": true,
    "asarUnpack": ["native/desktop-capture/build/*.node"],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*.cjs",
      "native/desktop-capture/build/*.node",
      "dist-renderer/**",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "electron/watcher.ps1",
        "to": "watcher.ps1"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "VioletFolders-${version}-win-x64.exe"
    },
    "artifactName": "VioletFolders-${version}-win-x64.${ext}",
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}

{
  "name": "Violet Folders Electron surface",
  "platform": "electron-react-windows",
  "mode": "operate",
  "authority": "User brief: adjustable liquid glass using rdev/liquid-glass-react, local desktop refraction, transparent gaps, readable stationary settings controls",
  "implementation": {
    "rendererEntry": "renderer/main.tsx",
    "appComponent": "renderer/App.tsx",
    "glassComponent": "renderer/Glass.tsx",
    "opticalGeometry": "renderer/optical-geometry.ts",
    "stylesheet": "renderer/style.css",
    "viteConfig": "vite.config.mts",
    "electronEntry": "electron/main.cjs",
    "glassControls": "renderer/GlassControls.tsx",
    "glassControlsStylesheet": "renderer/glass-controls.css",
    "glassDefaults": "renderer/glass-defaults.ts",
    "desktopSource": "electron/desktop-source.cjs",
    "desktopStream": "renderer/useDesktopStream.ts",
    "desktopFrameController": "renderer/desktop-stream-controller.ts",
    "desktopFrameReceiver": "renderer/desktop-frame-receiver.ts",
    "nativeCaptureController": "electron/native-desktop-capture.cjs",
    "nativeCaptureSource": "native/desktop-capture/desktop_capture.cc",
    "nativeBuild": "scripts/build-native-capture.mjs",
    "glassValidation": "electron/glass-settings.cjs"
  },
  "tokens": {
    "colorFormat": "CSS RRGGBBAA for eight-digit hex",
    "color": {
      "ink": "#FAF5FF",
      "secondary": "#D6C7E5",
      "violet": "#DCBAFF",
      "folderName": "#FAF3FF",
      "folderNameOnLight": "#281734",
      "parentPath": "#DFD1E9",
      "parentPathOnLight": "#4C365C",
      "glassIcon": "#E6D0FA",
      "glassIconOnLight": "#69408B",
      "menuSurface": "#21192C",
      "menuHover": "#42304F",
      "menuInk": "#FCF6FF",
      "focus": "#EFDAFF",
      "glassBorder": "#E3CEF340",
      "glassBackground": "transparent",
      "glassTintColor": "#4D256F",
      "glassTintOpacity": 0.12,
      "overLightBlackVeilOpacity": 0.38,
      "fallbackBlackVeilOpacity": 0.52,
      "glassInsetUpper": "#FFFFFF38",
      "glassInsetLower": "#B999E624"
    },
    "typography": {
      "family": "Segoe UI Variable, Microsoft YaHei UI, Segoe UI, sans-serif",
      "folderNameSizePx": 15,
      "folderNameWeight": 600,
      "parentPathSizePx": 11,
      "pathLineHeight": 1.15,
      "pathLineGapPx": 6,
      "pinLabelSizePx": 9,
      "brandSizePx": 13
    },
    "layout": {
      "shelfMaxWidthPx": 504,
      "shelfPaddingPx": ["8 + elasticY", 12, 10, 12],
      "shelfWidthFormula": "min(504, max(290, maxWidth - 2 * elasticX))",
      "elasticXFormula": "8 + ceil(100 * elasticity)",
      "elasticYFormula": "10 + ceil(22 * elasticity)",
      "rowHeightPx": 72,
      "rowGapPx": 10,
      "rowExtentPx": 82,
      "rowRadiusPx": 36,
      "headerWidthPx": 266,
      "headerHeightPx": 46,
      "headerRadiusPx": 23,
      "headerBottomGapPx": 12,
      "menuWidthPx": 266,
      "menuRadiusPx": 18,
      "glassControlsMaxWidthPx": 340,
      "glassControlsRadiusPx": 20,
      "glassControlsLeftPx": 12,
      "glassControlsTopPx": 65,
      "glassControlsReservedShelfWidthFormula": "min(720, maxWidth)",
      "glassControlsSideRule": "min(720, maxWidth) + 360 <= maxWidth",
      "glassControlsSideLeftPx": 730,
      "glassControlsSideTopPx": 8,
      "glassControlsIndependentOfElasticity": true
    },
    "glass": {
      "library": "liquid-glass-react",
      "mode": "standard",
      "displacementScale": 100,
      "blurAmount": 0.0625,
      "saturation": 140,
      "aberrationIntensity": 2,
      "elasticity": 0.15,
      "cornerRadius": 36,
      "tintOpacity": 0.12,
      "overLight": false,
      "desktopRefraction": true,
      "modes": ["standard", "polar", "prominent", "shader"],
      "padding": "0",
      "localSource": "per-surface canvas using transformed bounds and DIP-to-frame pixel mapping",
      "blurPxFormula": "(overLight ? 12 : 4) + blurAmount * 32",
      "opticalOverscanFormula": "ceil(3 * blurPx + maxRGBDisplacement / 2 + 3)",
      "filterRegionFollowsOverscan": true,
      "displacementMapRemainsCapsuleSized": true,
      "maskComposition": "arithmetic sum of complementary edge and center masks",
      "layerOrder": ["optical source", "violet tint", "black veil", "rim reflections", "sharp content"],
      "textShadow": "none",
      "adaptiveInk": {
        "samplePixels": 15,
        "sampleGrid": [5, 3],
        "sampleIntervalMs": 250,
        "includesSaturation": true,
        "includesTintAndBlackVeil": true,
        "initialLuminanceCrossover": 0.21,
        "lightToDarkThreshold": 0.25,
        "darkToLightThreshold": 0.17,
        "fallback": "light ink on stable dark veil"
      }
    },
    "desktopCapture": {
      "transport": "DXGI Desktop Duplication -> D3D11 shared texture -> Electron sharedTexture -> VideoFrame -> per-surface local canvas",
      "targetFrameRate": 30,
      "verification": "DXGI: 24/24 self-exclusion pixel checks including first frames; native backpressure and packaged automatic startup verified on Windows 10 22H2, 2560x1440; frame delivery follows desktop changes",
      "minimumWindowsBuild": 19041,
      "windows11Verification": "pending target-machine verification",
      "cursorCaptureEnabled": false,
      "separatePointerNeverComposited": true,
      "ambiguousSoftwarePointerFramesDiscarded": true,
      "wgcCaptureBorder": false,
      "selfExclusion": true,
      "selfExclusionVerifiedBeforeCapture": true,
      "dwmFlushBeforeCapture": true,
      "failedVerificationStartsCapture": false,
      "disableStopsCaptureAndReleasesTextures": true,
      "localMemoryOnly": true,
      "sharedGpuHandleTransport": true,
      "perFrameJpegEncoding": false,
      "perFrameImageIpc": false,
      "fullDesktopCpuReadback": false,
      "recording": false,
      "saving": false,
      "uploading": false
    },
    "nativeBuild": {
      "command": "npm run build:native",
      "requires": ["Visual Studio C++ x64 build tools", "Windows SDK with C++/WinRT", "Node.js", "npm"],
      "automaticFor": ["npm run dev", "npm run dist", "CI packaging"],
      "packagedRuntimeRequiresCompilerOrSdk": false
    },
    "motion": {
      "rowEntranceMs": 380,
      "rowEntranceEasing": "cubic-bezier(.16,1,.3,1)",
      "rowTranslationStartPx": -10,
      "rowOpacityStart": 0.3,
      "listFoldMs": 280,
      "menuEntranceMs": 160,
      "respectPrefersReducedMotion": true
    }
  },
  "constraints": [
    "No shared opaque background between folder capsules",
    "Folder name is prominent above its parent path",
    "Settings menu remains opaque and readable",
    "Empty and collapsed states keep a compact header unless settings are open",
    "Pins survive Explorer closure and application restart",
    "Transparent gaps forward pointer input where the native platform allows",
    "DXGI frames without composited pointers supply each library filter through a shared GPU frame source and local canvas",
    "Verify self-exclusion and settle desktop composition before enabling capture",
    "Disabling desktop capture stops capture and releases shared textures",
    "Unavailable desktop capture falls back to transparent glass with a stable dark veil and light ink",
    "Adaptive ink includes saturation and uses hysteresis; text stays above optical and tint layers without shadows",
    "Overscan and the filter region expand together while preserving the capsule-sized displacement map",
    "Elastic stretching retains visible space and matching hit regions",
    "Glass settings position and size stay independent of elasticity"
  ]
}
